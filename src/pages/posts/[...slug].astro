---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatDate,
  getVisiblePosts,
  postExcerpt,
  postHref,
  sortPosts,
  type Post,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = sortPosts(getVisiblePosts(await getCollection("posts")));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const description = postExcerpt(post);
---

<BaseLayout title={post.data.title} description={description}>
  <article class="post-page">
    <header class="post-header">
      <a class="back-link" href={`${base}#posts`}><span aria-hidden="true">←</span> Back to posts</a>
      <div class="post-header-meta">
        <span>{formatDate(post.data.date)}</span>
        <span>{post.data.tags[0] ?? "Post"}</span>
      </div>
      <h1>{post.data.title}</h1>
      {description && <p class="post-deck">{description}</p>}
      {post.data.tags.length > 0 && (
        <div class="post-tags" aria-label="Tags">
          {post.data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <a class="back-link" href="#main-content"><span aria-hidden="true">↑</span> Top</a>
      <a class="text-link" href={`${base}#posts`}>All posts <span aria-hidden="true">↗</span></a>
    </footer>
  </article>
</BaseLayout>
