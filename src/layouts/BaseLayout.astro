---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Personal posts by Changseo Jang.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const profileLogo = "https://beleap.github.io/profile/profile-64.png";
const pageTitle = title === "BeLeap" ? "BeLeap" : `${title} · BeLeap`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={profileLogo} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.url} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <div class="site-shell">
      <aside class="site-rail" aria-label="사이트 탐색">
        <div class="rail-top">
          <a class="brand" href={home} aria-label="BeLeap 홈">
            <img class="brand-mark" src={profileLogo} alt="" width="40" height="40" />
            <span class="brand-name">BeLeap</span>
          </a>
          <p class="rail-kicker">BLOG</p>
          <div class="rail-rule" aria-hidden="true"></div>
          <p class="rail-intro">
            Personal posts.
          </p>
          <nav class="rail-nav" aria-label="주 메뉴">
            <a href={home} class="rail-nav-link"><span>01</span>Home</a>
            <a href={`${home}#posts`} class="rail-nav-link"><span>02</span>Posts</a>
            <a href={`${home}#about`} class="rail-nav-link"><span>03</span>About</a>
          </nav>
        </div>
        <div class="rail-bottom">
          <div class="rail-meta">
            <span>SEOUL / KR</span>
          </div>
        </div>
      </aside>
      <main id="main-content" class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>
